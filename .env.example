# Local development may use http://localhost:3000.
# Production India checkout requires the final canonical HTTPS origin, for example https://radvora.com.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only secrets. Never expose these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# India-only production payment gateway.
# New checkout uses expiring Standard Razorpay Payment Links in INR.
# Production merchant/KYC activation and real credentials are required before payment collection is enabled.
# Required signed webhook events: payment_link.paid, payment_link.cancelled,
# payment_link.expired, refund.processed and refund.failed.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional / future integrations. These are not required for India commerce checkout.
OPENAI_API_KEY=""
GEMINI_API_KEY=""
